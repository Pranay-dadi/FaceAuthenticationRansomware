<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ── Header ── -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_lock_alert"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:contentDescription="Lock alert"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textColor="#FFF44336"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/tvConfidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#88FFFFFF"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#66FFFFFF"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"/>

        <!-- ── Stage progress card ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33F44336"
            android:layout_marginVertical="16dp"/>

        <TextView
            android:id="@+id/tvStageLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Initialising..."
            android:textSize="13sp"
            android:textColor="#FFF44336"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvStageStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#CCFFFFFF"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvStageDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="#AAFFFFFF"
            android:fontFamily="monospace"
            android:layout_marginTop="6dp"
            android:padding="10dp"
            android:background="@drawable/bg_card_danger"
            android:lineSpacingExtra="3dp"/>

        <!-- ── Before / After encryption panel ── -->
        <LinearLayout
            android:id="@+id/layoutEncryptionResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Filesystem — Before vs After"
                android:textSize="13sp"
                android:textColor="#FFF44336"
                android:textStyle="bold"/>

            <!-- BEFORE panel -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BEFORE (plaintext)"
                android:textSize="11sp"
                android:textColor="#66FF8A65"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvBeforeFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#AAFFFFFF"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:lineSpacingExtra="2dp"/>

            <!-- AFTER panel -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AFTER (encrypted)"
                android:textSize="11sp"
                android:textColor="#66F44336"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvAfterFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#AAFFFFFF"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:lineSpacingExtra="2dp"
                android:background="@drawable/bg_card_danger"/>

        </LinearLayout>

        <!-- ── Filesystem lockdown probe ── -->
        <LinearLayout
            android:id="@+id/layoutFsProbe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvFsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#FFF44336"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvFsReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#CCFFFFFF"
                android:fontFamily="monospace"
                android:layout_marginTop="6dp"
                android:padding="10dp"
                android:lineSpacingExtra="3dp"
                android:background="@drawable/bg_card_danger"/>

        </LinearLayout>

        <!-- ── Dismiss ── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDismiss"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Dismiss"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:backgroundTint="#FFF44336"
            app:cornerRadius="12dp"/>

    </LinearLayout>
</ScrollView>
