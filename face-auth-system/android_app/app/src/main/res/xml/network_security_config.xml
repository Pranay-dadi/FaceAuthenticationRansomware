<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security config.

    Android 9+ blocks cleartext (plain HTTP) traffic by default.
    This config permits HTTP ONLY to 10.0.2.2 (the Android emulator's
    special alias for the host machine's localhost).

    All other traffic remains restricted to HTTPS.

    Place at: app/src/main/res/xml/network_security_config.xml
-->
<network-security-config>
    <!-- Allow plain HTTP only to the payload server on the host machine -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <!-- Everything else must use HTTPS -->
    <base-config cleartextTrafficPermitted="false"/>
</network-security-config>
